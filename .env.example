# Copy to .env.local for local development, or set these in the Vercel
# dashboard (Project → Settings → Environment Variables). Never commit real keys.

# Required for the "Ask about my work" assistant. Create one at console.groq.com.
# Without it the site works and the assistant explains that it's switched off.
GROQ_API_KEY=

# Optional: which Groq model answers. Default: llama-3.3-70b-versatile
GROQ_MODEL=

# Optional: the site's public address, for the sitemap, robots.txt and share
# images. Set it once you have a custom domain; until then Vercel's production
# URL is used automatically.
NEXT_PUBLIC_SITE_URL=
